{
  "name": "shiftmanager",
  "version": "1.0.0",
  "private": true,
  "description": "保育園向け勤務表管理システム",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:seed": "npx prisma db seed",
    "db:seed:staff": "npx tsx prisma/seed.ts",
    "db:import:shift-json": "npx tsx scripts/import-shift-schedule-from-json.ts",
    "db:seed:may-shift": "npx tsx scripts/seed-may-shift-schedule.ts",
    "db:import:roster-json": "npx tsx scripts/import-roster-from-json.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
